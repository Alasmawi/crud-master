# Single source of configuration. Read by the Vagrantfile (VM setup) and by
# each app's server.py (local runs). Values below are the local/in-VM defaults;
# the Vagrantfile overrides the cross-VM addresses for gateway-vm.

# Vagrant
VAGRANT_BOX=bento/ubuntu-22.04
INVENTORY_VM_IP=192.168.56.11
BILLING_VM_IP=192.168.56.12
GATEWAY_VM_IP=192.168.56.13

# PostgreSQL - Inventory (inventory-vm)
INVENTORY_DB_HOST=localhost
INVENTORY_DB_PORT=5432
INVENTORY_DB_NAME=movies_db
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_pass

# PostgreSQL - Billing (billing-vm)
BILLING_DB_HOST=localhost
BILLING_DB_PORT=5432
BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=billing_pass

# RabbitMQ (billing-vm). Not "guest": guest can only log in from localhost.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=rabbit_user
RABBITMQ_PASSWORD=rabbit_pass
BILLING_QUEUE=billing_queue

# Inventory API
INVENTORY_APP_HOST=0.0.0.0
INVENTORY_APP_PORT=8080

# API Gateway
GATEWAY_APP_HOST=0.0.0.0
GATEWAY_APP_PORT=3000
INVENTORY_API_URL=http://localhost:8080
